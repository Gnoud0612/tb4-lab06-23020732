<?xml version="1.0"?>
<plugin filename="GzScene3D" name="3D View">
  <ignition-gui><title>TurtleBot 4 - Empty gesture arena</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
  <engine>ogre2</engine><scene>scene</scene><camera_pose>-2.8 -3.5 3.2 0 0.62 0.9</camera_pose>
</plugin>
<plugin filename="WorldControl" name="World control">
  <ignition-gui><property type="string" key="state">floating</property><property type="double" key="width">140</property><property type="double" key="height">70</property><property type="bool" key="showTitleBar">false</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <ignition-gui><property type="string" key="state">floating</property><property type="double" key="width">280</property><property type="double" key="height">100</property><property type="bool" key="showTitleBar">false</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
</plugin>
